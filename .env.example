# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings → JWT Secret (used to verify tokens)
SUPABASE_JWT_SECRET=

# Project Settings → Database → Connection string → JDBC
# Use the Session pooler (port 5432) or Transaction pooler (6543) for serverless.
DATABASE_URL=jdbc:postgresql://YOUR-HOST:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ── Web (apps/web) ────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are exposed to the browser. Only put safe keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── API (apps/api) ────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# 32-byte base64 key for AES-256-GCM encryption of OAuth refresh tokens (Phase 2).
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── OAuth: email ingestion (Phase 2, not needed yet) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Observability (Phase 6, optional) ─────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
