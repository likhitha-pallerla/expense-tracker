# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared HS256 secret. NOT used for token verification: Supabase signs
# access tokens with ES256 and the API verifies them via the project's JWKS
# endpoint. Kept only for tools that still expect the legacy secret.
SUPABASE_JWT_SECRET=

# Project Settings → Database → Connection string → JDBC
# Use the Session pooler (port 5432) or Transaction pooler (6543) for serverless.
DATABASE_URL=jdbc:postgresql://YOUR-HOST:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ── Web (apps/web) ────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are exposed to the browser. Only put safe keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── API (apps/api) ────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# 32-byte base64 key for AES-256-GCM encryption of stored OAuth tokens.
# Generate: openssl rand -base64 32
# Absent, the API still boots and refuses only when a mailbox is linked.
TOKEN_ENCRYPTION_KEY=

# ── OAuth: email ingestion ────────────────────────────────────────────
# Register the redirect URI with each provider as
#   {OAUTH_API_BASE}/api/connections/callback/gmail
#   {OAUTH_API_BASE}/api/connections/callback/outlook
# Leave a pair blank and that provider is simply switched off in the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Public URLs used to build the redirect URI and the trip back to the web app.
OAUTH_API_BASE=http://localhost:8080
OAUTH_WEB_BASE=http://localhost:3000

# ── AI (optional) ─────────────────────────────────────────────────────
# Off by default, and everything works with it off: the rules read alerts,
# the deterministic sentence explains the month, and the typing box asks you
# to rephrase instead of guessing. Switching it on only adds a second attempt
# where the rules gave up.
#
# The API never sends a figure it has calculated to a model, and never uses a
# figure a model returns without re-parsing and range-checking it. Card
# numbers, account numbers, one-time codes, balances, phone numbers and email
# addresses are stripped before any text leaves the machine.
AI_ENABLED=false
AI_API_KEY=
# Any OpenAI-compatible endpoint: OpenAI, Groq, Together, OpenRouter, or a
# local llama.cpp / Ollama server on your own machine.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Below this, a reading is discarded rather than shown. 0.75 is deliberately
# strict: a wrong transaction is worse than no transaction.
AI_MIN_CONFIDENCE=0.75
# A hard daily ceiling on calls per user, counted before the call is made.
# Reaching it switches the AI off for that user until tomorrow; it never
# bills you past this number.
AI_DAILY_CALL_BUDGET=200
# Seconds to wait for a reply before giving up and using the rules' answer.
AI_TIMEOUT_SECONDS=20

# ── Observability (Phase 6, optional) ─────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
