# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are inlined into the
# shipped bundle, so only put things here that are safe for a client to hold.
# The Supabase anon key qualifies; the service key never does.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the Spring Boot API is listening.
#   Android emulator : http://10.0.2.2:8080  (the default)
#   Physical device  : http://<your-machine-ip>:8080
#   Deployed         : https://your-api.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
