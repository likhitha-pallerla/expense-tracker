<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Declared by the module that uses it rather than in the app manifest, so the
    permission travels with the code that needs it. Removing this module from
    the build removes the permission from the APK.
  -->
  <uses-permission android:name="android.permission.READ_SMS" />
</manifest>
